@PACKAGE_INIT@

#
#  MNECPPConfig.cmake — generated by CMake for MNE-CPP @MNE_CPP_VERSION@
#
#  Every library is a component and an imported target MNE-CPP::<library>:
#
#    @MNECPP_LIBRARIES@
#
#  Usage:
#    find_package(MNE-CPP @MNE_CPP_VERSION@ REQUIRED COMPONENTS fiff dsp acq)
#    target_link_libraries(my_app PRIVATE MNE-CPP::mne_fiff MNE-CPP::mne_dsp MNE-CPP::mne_acq)
#
#  Components are library names with or without the mne_ prefix. Only the Qt modules the requested
#  libraries and their MNE-CPP dependencies use are looked up, so headless components (e.g. fiff, dsp,
#  acq) need neither Qt Gui nor Qt Widgets. Without COMPONENTS every library is requested.
#
#  Legacy variables (for compatibility with non-target-based projects):
#    MNE_CPP_FOUND          - TRUE
#    MNE_CPP_INCLUDE_DIRS   - Include directories
#    MNE_CPP_LIBRARY_DIRS   - Library directories
#    MNE_CPP_LIBRARIES      - List of library names
#    MNE_CPP_VERSION        - Version string
#

include(CMakeFindDependencyMacro)

# Generated from each library's link libraries: MNE-CPP libraries, Qt modules and Eigen it uses.
@MNECPP_COMPONENT_MAP@
set(_mnecpp_all @MNECPP_LIBRARIES@)

set(_mnecpp_queue "")
foreach(_c IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    string(REGEX REPLACE "^mne_" "" _name "${_c}")
    if("mne_${_name}" IN_LIST _mnecpp_all)
        set(${CMAKE_FIND_PACKAGE_NAME}_${_c}_FOUND TRUE)
        list(APPEND _mnecpp_queue mne_${_name})
    else()
        set(${CMAKE_FIND_PACKAGE_NAME}_${_c}_FOUND FALSE)
    endif()
endforeach()
if(NOT ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    set(_mnecpp_queue ${_mnecpp_all})
endif()

# The requested libraries with everything they link
set(_mnecpp_needed "")
while(_mnecpp_queue)
    list(POP_FRONT _mnecpp_queue _lib)
    if(NOT _lib IN_LIST _mnecpp_needed)
        list(APPEND _mnecpp_needed ${_lib})
        list(APPEND _mnecpp_queue ${_mnecpp_libs_${_lib}})
    endif()
endwhile()

set(_mnecpp_qt "")
set(_mnecpp_eigen OFF)
foreach(_lib IN LISTS _mnecpp_needed)
    list(APPEND _mnecpp_qt ${_mnecpp_qt_${_lib}})
    if(_mnecpp_eigen_${_lib})
        set(_mnecpp_eigen ON)
    endif()
endforeach()
list(REMOVE_DUPLICATES _mnecpp_qt)

# mne_acq uses std::thread primitives (semaphores) and links Threads::Threads.
find_dependency(Threads)
if(_mnecpp_qt)
    find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS ${_mnecpp_qt})
endif()
# Eigen is header-only, bundled with MNE-CPP and installed alongside it.
if(_mnecpp_eigen AND NOT TARGET Eigen3::Eigen)
    find_dependency(Eigen3 HINTS "${PACKAGE_PREFIX_DIR}/share/eigen3/cmake"
                                 "${PACKAGE_PREFIX_DIR}/lib/cmake/eigen3")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MNECPPTargets.cmake")

# Public headers include the Qt modules and Eigen a library links privately, so consumers get them too.
foreach(_lib IN LISTS _mnecpp_needed)
    set(_iface "")
    foreach(_module IN LISTS _mnecpp_qt_${_lib})
        list(APPEND _iface Qt@QT_VERSION_MAJOR@::${_module})
    endforeach()
    if(_mnecpp_eigen_${_lib})
        list(APPEND _iface Eigen3::Eigen)
    endif()
    if(_iface)
        set_property(TARGET MNE-CPP::${_lib} APPEND PROPERTY INTERFACE_LINK_LIBRARIES ${_iface})
    endif()
endforeach()

# Legacy variables for downstream projects that don't use targets
set(MNE_CPP_FOUND TRUE)
set(MNE_CPP_VERSION "@MNE_CPP_VERSION@")
set(MNE_CPP_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
set(MNE_CPP_LIBRARY_DIRS "${PACKAGE_PREFIX_DIR}/lib")
set(MNE_CPP_LIBRARIES ${_mnecpp_needed})

unset(_mnecpp_all)
unset(_mnecpp_queue)
unset(_mnecpp_needed)
unset(_mnecpp_qt)
unset(_mnecpp_eigen)
unset(_iface)

check_required_components(${CMAKE_FIND_PACKAGE_NAME})
